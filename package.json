{
  "name": "shakespread",
  "private": true,
  "version": "1.2.0-prototype.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "glyphs:build": "python scripts/build_glyphs.py",
    "test:chinese": "playwright test tests/browser/chinese.spec.js",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "test:pipeline": "python scripts/verify_glyph_pipeline.py",
    "test:production": "node scripts/verify-xingshu-production.mjs",
    "glyphs:xingshu": "node scripts/build-xingshu.mjs",
    "test:xingshu": "playwright test tests/browser/xingshu.spec.js",
    "test:xingshu:masks": "node scripts/verify-xingshu-masks.mjs",
    "test:masks": "node scripts/verify-glyph-masks.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
